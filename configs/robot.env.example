# Copy to ~/.config/piper-rlt.env and edit for the target host.
# This file intentionally contains no secret.

PIPER_CAN_INTERFACE=can0
PIPER_CAN_BITRATE=1000000
PIPER_POLICY_CONFIG=pi05_piper_greenblock_5090_jax_delta_v1
PIPER_POLICY_CHECKPOINT=$HOME/openpi_checkpoints/pi05_piper_greenblock_5090_jax_delta_v1/piper_greenblock_5090_delta_sft_30k_20260707/20000
PIPER_RL_TOKEN_CHECKPOINT=$HOME/openpi_rlt/rl_tokens/pi05_piper_greenblock_5090_full20k_rlt_token_v1_20260709/step_010000_encoder_only
PIPER_PHASE_CHECKPOINT=$HOME/rlt_phase_classifiers/greenblock_box_resnet18_v4_manual_intervals/phase_classifier.pt
PIPER_SFT_DATASET_ROOT=$HOME/datasets/piper_greenblock_5090_v2_openpi_view_20260707
PIPER_PI05_BASE_PARAMS=$HOME/.cache/openpi/openpi-assets/checkpoints/pi05_base/params
PIPER_OPENPI_ASSETS_DIR=$HOME/gripper_close_v3_staging_20260727/assets
PIPER_OPENPI_CHECKPOINT_DIR=$HOME/openpi_checkpoints

# RealSense role mapping used by the trained model.
PIPER_GLOBAL_CAMERA_SERIAL=347522072112
PIPER_WRIST_CAMERA_SERIAL=260622272544
PIPER_CAMERA_WIDTH=640
PIPER_CAMERA_HEIGHT=480
PIPER_CAMERA_FPS=30

# Runtime layout matching the verified 5090 snapshot.
RLT_V3_STAGING=$HOME/gripper_close_v3_staging_20260727
RLT_SESSIONS_ROOT=$HOME/rlt_online_sessions
RLT_LINEAGE=greenblock_rlt_fresh_v3_20260729
RLT_STATE_DIR=.online_rlt_persistent_gripper_v3_fresh
PIPER_RLT_PIKA_PYTHON=$HOME/venvs/pika/bin/python
JAX_COMPILATION_CACHE_DIR=$HOME/.cache/jax/piper-rlt
XLA_PYTHON_CLIENT_PREALLOCATE=false
