[Unit]
Description=Persistent Piper native SDK command bridge for RLT
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/cwzk/piper_jax_inference_v1
Environment=PYTHONPATH=/home/cwzk/piper_jax_inference_v1:/home/cwzk/pika_ros/install/lib/python3/dist-packages:/opt/ros/noetic/lib/python3/dist-packages
ExecStart=/home/cwzk/venvs/pika/bin/python -u -m piper_runtime.native_sdk_command_bridge
Restart=on-failure
RestartSec=2
TimeoutStopSec=10

[Install]
WantedBy=default.target
