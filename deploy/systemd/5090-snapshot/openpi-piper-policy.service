[Unit]
Description=OpenPI Piper JAX policy server
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/cwzk/openpi_jax_piper_lora_v1_20260707
Environment=PYTHONPATH=/home/cwzk/piper_jax_inference_v1:/home/cwzk/openpi_jax_piper_lora_v1_20260707/src:/home/cwzk/openpi_jax_piper_lora_v1_20260707/packages/openpi-client/src
Environment=XLA_PYTHON_CLIENT_PREALLOCATE=false
Environment=XLA_PYTHON_CLIENT_MEM_FRACTION=0.90
Environment=JAX_COMPILATION_CACHE_DIR=/home/cwzk/piper_jax_inference_v1/jax_cache
ExecStart=/home/cwzk/openpi_jax_piper_lora_v1_20260707/.venv/bin/python -m piper_runtime.policy_service
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
StandardOutput=append:/home/cwzk/piper_jax_inference_v1/logs/policy_server.log
StandardError=append:/home/cwzk/piper_jax_inference_v1/logs/policy_server.log

[Install]
WantedBy=default.target
